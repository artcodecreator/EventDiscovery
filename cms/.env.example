# Strapi server
HOST=0.0.0.0
PORT=1337
APP_KEYS=replace-key-one,replace-key-two,replace-key-three,replace-key-four
API_TOKEN_SALT=replace-with-a-random-value
ADMIN_JWT_SECRET=replace-with-a-random-value
TRANSFER_TOKEN_SALT=replace-with-a-random-value
JWT_SECRET=replace-with-a-random-value
ENCRYPTION_KEY=replace-with-a-random-value

# PostgreSQL (recommended); set DATABASE_CLIENT=mysql to use MySQL
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=event_discovery
DATABASE_USERNAME=event_discovery
DATABASE_PASSWORD=replace-with-a-database-password
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Cloudinary uploads
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# GraphQL playground should remain disabled in production
GRAPHQL_PLAYGROUND=false
